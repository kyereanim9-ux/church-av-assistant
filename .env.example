# --- Base de données ---
# Postgres gratuit recommandé : Neon (intégré à Vercel), Supabase ou Railway.
# En local, vous pouvez utiliser une base Neon gratuite aussi (la même que la prod,
# ou une "branche" Neon séparée pour le développement), ou un Postgres local/Docker.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# --- Authentification ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-moi-avec-openssl-rand-base64-32"

# --- IA (facultatif au démarrage) ---
# L'application fonctionne sans clé : l'Assistant IA et l'identification photo
# afficheront un message clair au lieu de planter. Ajoutez une clé pour les activer.
AI_PROVIDER="anthropic"
ANTHROPIC_API_KEY=""
# Fournisseur alternatif pris en charge par la même interface (voir src/lib/ai.ts)
# AI_PROVIDER="openai"
# OPENAI_API_KEY=""

# --- Photos (facultatif) ---
# Laissez vide en local : les photos sont écrites dans /public/uploads.
# Sur Vercel, activez Vercel Blob (gratuit) : la variable ci-dessous est alors
# ajoutée automatiquement par Vercel, vous n'avez rien à taper manuellement.
BLOB_READ_WRITE_TOKEN=""

# --- Compte administrateur créé par le seed ---
SEED_ADMIN_EMAIL="admin@eglise.local"
SEED_ADMIN_PASSWORD="changeme123"
